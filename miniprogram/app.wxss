page { background: #f5f6f8; font-size: 28rpx; color: #333; }
.form-card { background: #fff; border-radius: 16rpx; margin: 24rpx; padding: 8rpx 28rpx; }
.form-item { display: flex; align-items: flex-start; padding: 24rpx 0; border-bottom: 1rpx solid #eef0f3; }
.form-item:last-child { border-bottom: none; }
.form-label { width: 190rpx; color: #333; flex-shrink: 0; line-height: 56rpx; }
.form-label .req { color: #e24b4a; margin-right: 4rpx; }
.form-item input, .form-item picker { flex: 1; height: 56rpx; line-height: 56rpx; }
.meals { display: flex; gap: 20rpx; flex: 1; }
.meal-tag { padding: 8rpx 28rpx; border-radius: 30rpx; border: 1rpx solid #d9dce3; font-size: 26rpx; }
.meal-tag.on { background: #e6f1fb; border-color: #185fa5; color: #185fa5; }
.btn-area { padding: 30rpx 24rpx 60rpx; }
.btn-primary { background: #185fa5; color: #fff; border-radius: 44rpx; font-size: 32rpx; }
.btn-primary[disabled] { background: #a9c4dd; }
.tip { font-size: 24rpx; color: #999; padding: 0 32rpx; }
.success-box { background: #fff; border-radius: 16rpx; margin: 120rpx 40rpx; padding: 60rpx 40rpx; text-align: center; }
.success-code { font-size: 72rpx; font-weight: 600; letter-spacing: 12rpx; color: #185fa5; margin: 30rpx 0; }
.order-card { background: #fff; border-radius: 16rpx; margin: 24rpx; padding: 28rpx; }
.order-line { display: flex; padding: 8rpx 0; font-size: 27rpx; }
.order-line .k { width: 180rpx; color: #888; flex-shrink: 0; }
.status-tag { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 10rpx; }
.st-pending { background: #faeeda; color: #854f0b; }
.st-assigned { background: #e1f5ee; color: #0f6e56; }
.st-rejected { background: #fcebeb; color: #a32d2d; }
.route-title { font-weight: 500; margin: 20rpx 0 10rpx; color: #0f6e56; }
.route-img { width: 100%; height: 400rpx; object-fit: cover; border-radius: 12rpx; margin-bottom: 16rpx; }
.query-bar { display: flex; gap: 16rpx; padding: 24rpx; }
.query-bar input { flex: 1; background: #fff; border-radius: 12rpx; padding: 16rpx 24rpx; }
