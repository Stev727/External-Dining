# 环境变量模板 —— 复制为 .env 后填写；.env 不入 git
PORT=48081
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=填写MySQL密码
DB_NAME=meal_order

# 小程序（Secret 建议只放这里，不入库不入 git）
WX_APPID=wx5ef7045b02e21f4c
WX_APPSECRET=填写AppSecret
WX_SUB_TEMPLATE_ID=

# 钉钉工作通知（推送到个人钉钉）：企业内部应用凭据 —— open-dev.dingtalk.com 创建应用后获取
DINGTALK_APPKEY=
DINGTALK_APPSECRET=
DINGTALK_AGENT_ID=
# 群机器人 Webhook（可选备用通道，工作通知未配置/失败时回退群推送）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 管理口令
ADMIN_PASSWORD=填写管理口令
JWT_SECRET=填写随机长字符串
